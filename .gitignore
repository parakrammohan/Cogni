node_modules/
dist/
.vercel/
.DS_Store
*.local
.env
.env.*
!.env.example
.scratch-*.md
# Datasets themselves are huge (~6 GB) and aren't shipped in git; only
# the training/eval scripts that operate on them are tracked, so a
# remote GPU box can `git clone` and run a sweep.
datasets/*
!datasets/scripts/
!datasets/scripts/*.py
.venv/

# Local-only tooling — never push these
.claude/
.playwright/
.playwright-cli/
CLAUDE.md

# Python build cruft
__pycache__/
*.pyc
*.pyo
.pytest_cache/
